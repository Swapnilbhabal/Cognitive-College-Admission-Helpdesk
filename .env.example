# Copy this file, rename the copy to .env and fill in your own values.
# Never upload the real .env file to GitHub.

# Gmail account that sends the summary emails
EMAIL_ADDRESS=your_gmail@gmail.com
# 16-character Gmail App Password (not your normal Gmail password)
EMAIL_PASSWORD=your_16_char_app_password

# ElevenLabs API key (used to fetch the conversation summary)
ELEVENLABS_API_KEY=your_elevenlabs_api_key
